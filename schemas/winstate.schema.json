{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winstate.dev/schemas/winstate.schema.json",
  "title": "WinState Profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "metadata"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "profileVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "strictMode": { "type": "boolean", "default": false },
        "removeUnmanagedPackages": { "type": "boolean", "default": false },
        "allowReboot": { "type": "boolean", "default": false }
      }
    },
    "variables": { "$ref": "#/$defs/stringMap" },
    "includes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "extends": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "user": { "$ref": "#/$defs/stringMap" },
        "machine": { "$ref": "#/$defs/stringMap" },
        "userPath": { "$ref": "#/$defs/pathEntries" },
        "machinePath": { "$ref": "#/$defs/pathEntries" }
      }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/wingetPackage" }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/windowsFeature" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "pathEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["present", "absent"], "default": "present" },
          "position": { "enum": ["prepend", "append"], "default": "append" }
        }
      }
    },
    "wingetPackage": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["present", "absent"], "default": "present" },
        "version": { "type": "string", "minLength": 1, "default": "latest" },
        "source": { "type": "string", "minLength": 1, "default": "winget" },
        "scope": { "enum": ["user", "machine"], "default": "user" },
        "allowUpgrade": { "type": "boolean", "default": true },
        "mayRequireReboot": { "type": "boolean", "default": false }
      }
    },
    "windowsFeature": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "enum": ["enabled", "disabled"], "default": "enabled" },
        "includeParents": { "type": "boolean", "default": true }
      }
    }
  }
}
